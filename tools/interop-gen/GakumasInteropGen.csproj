    <Reference Include="MonoMod.Utils">
      <HintPath>$(GakumasRoot)\BepInEx\core\MonoMod.Utils.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Backports">
      <HintPath>$(GakumasRoot)\BepInEx\core\MonoMod.Backports.dll</HintPath>
    </Reference>
    <Reference Include="Disarm">
